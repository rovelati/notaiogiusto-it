---
import { absoluteUrl } from '../lib/site';

const {
  title = 'NotaioGiusto.it',
  description = 'Trova il notaio giusto, capisci i costi e richiedi un preventivo notarile qualificato.',
  noindex = false,
  canonicalPath,
  jsonLd,
} = Astro.props;

const canonical = absoluteUrl(canonicalPath || Astro.url.pathname);
const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const navItems = [
  { href: '/quanto-costa', label: 'Quanto costa?' },
  { href: '/notai', label: 'Cerca notai' },
  { href: '/preventivo', label: 'Preventivo' },
  { href: '/area-clienti', label: 'Area clienti' },
  { href: '/area-notai', label: 'Area notai' },
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="stylesheet" href="/styles.css" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="NotaioGiusto.it">
        <span class="brand-mark">N</span>
        <span>
          <strong>NotaioGiusto.it</strong>
          <small>Notai, costi e preventivi</small>
        </span>
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Apri menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="nav" id="site-nav">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <strong>NotaioGiusto.it</strong>
      <span>I costi sono indicativi: imposte e spese variano in base alla pratica.</span>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('#site-nav');
      if (toggle && nav) {
        const setOpen = (open) => {
          document.body.classList.toggle('nav-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
        };
        toggle.addEventListener('click', () => {
          setOpen(!document.body.classList.contains('nav-open'));
        });
        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      }
    </script>
  </body>
</html>
