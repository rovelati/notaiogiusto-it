---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotaiSearchBar from '../components/NotaiSearchBar.astro';
import { euro } from '../lib/format';
import { getStats, getTopServices } from '../lib/notai';

const [services, stats] = await Promise.all([getTopServices(9), getStats()]);

const heroActions = [
  {
    label: 'Quanto costa?',
    helper: 'Range indicativi per le pratiche più comuni',
    href: '/quanto-costa',
  },
  {
    label: 'Cerca notai',
    helper: 'Profili da fonte ufficiale Notariato',
    href: '/notai',
  },
  {
    label: 'Preventivo',
    helper: 'Richiesta guidata fino a 10 studi',
    href: '/preventivo',
    nofollow: true,
  },
];
---
<BaseLayout title="NotaioGiusto.it | Trova il notaio giusto e arriva preparato all'atto">
  <section class="home-hero">
    <div class="home-hero__glow" aria-hidden="true"></div>
    <div class="home-hero__inner">
      <div class="home-hero__intro">
        <img
          class="home-hero__logo"
          src="/brand/mark.svg"
          width="72"
          height="72"
          alt=""
          decoding="async"
        />
        <h1>NotaioGiusto.it</h1>
        <p class="home-hero__tagline">Trova il notaio giusto e arriva preparato all’atto</p>
        <div class="home-hero__actions">
          {heroActions.map((action) => (
            <a class="home-hero__action" href={action.href} rel={action.nofollow ? 'nofollow' : undefined}>
              <img class="home-hero__action-mark" src="/brand/mark.svg" width="34" height="34" alt="" decoding="async" />
              <span>
                <strong>{action.label}</strong>
                <em>{action.helper}</em>
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="home-hero__search">
        <NotaiSearchBar variant="hero" />
        <p class="home-hero__hint">
          Cosa = nome o pratica. Dove = città.
          <a href="/preventivo" rel="nofollow">Oppure vai al preventivo guidato</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading section-heading--center">
      <span class="eyebrow">Quanto costa?</span>
      <h2>Le pratiche notarili più cercate</h2>
      <p>Ogni pagina spiega quando serve la prestazione, cosa incide sul prezzo, quali documenti preparare e come chiedere un preventivo.</p>
    </div>
    <div class="grid">
      {services.map((service) => (
        <a class="card" href={`/quanto-costa/${service.slug}`}>
          <h3>{service.plain_language_name || service.name}</h3>
          <p>{service.user_intent}</p>
          <div class="price">{euro(service.price_avg_cents)}</div>
          <div class="meta">
            <span class="pill green">Preventivo qualificato</span>
            <span class="pill gold">
              Complessità {(service.complexity || 'media').replace(/^./, (c) => c.toUpperCase())}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section soft">
    <div class="two-col">
      <div>
        <span class="eyebrow">Come funziona</span>
        <h2>Non basta chiedere “quanto costa?”</h2>
        <p class="lead">Per confrontare davvero i preventivi servono pratica, valore, luogo, tempi, documenti già disponibili e complessità. Il prezzo conta, ma deve essere leggibile.</p>
      </div>
      <div class="card">
        <h3>Base dati in costruzione</h3>
        <p>
          Partiamo da {Number(stats.notaries).toLocaleString('it-IT')} notai da fonte ufficiale e {stats.services} servizi classificati.
          I numeri servono come garanzia tecnica, non come messaggio principale per l’utente.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
