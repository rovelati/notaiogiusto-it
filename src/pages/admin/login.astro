---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAdminEmail,
  getAdminPassword,
  hasAdminAuthSecret,
  isAdminAuthenticated,
  isAdminEmail,
  setAdminSession,
} from '../../lib/admin';
import { isGoogleOAuthConfigured } from '../../lib/google-oauth';

export const prerender = false;

const nextRaw = Astro.url.searchParams.get('next') || '/admin-test';
const next = nextRaw.startsWith('/admin') ? nextRaw : '/admin-test';

if (isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect(next);
}

const googleEnabled = isGoogleOAuthConfigured();
const googleHref = `/api/auth/google/start?audience=admin&redirect_to=${encodeURIComponent(next)}`;

let error = '';
if (Astro.url.searchParams.get('errore') === 'google') {
  error = 'Accesso Google non riuscito. Riprova.';
}
if (Astro.url.searchParams.get('errore') === 'forbidden') {
  error = 'Questo account Google non è autorizzato come admin.';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') || '').trim().toLowerCase();
  const password = String(form.get('password') || '');
  const redirectTo = String(form.get('next') || next);
  const safeNext = redirectTo.startsWith('/admin') ? redirectTo : '/admin-test';

  if (!hasAdminAuthSecret()) {
    error = 'AUTH_SECRET / ADMIN_TOKEN non configurato sul server.';
  } else if (!isAdminEmail(email)) {
    error = 'Email non autorizzata.';
  } else {
    const expected = getAdminPassword();
    if (!expected || password !== expected) {
      error = 'Password non valida.';
    } else {
      setAdminSession(Astro.cookies, email);
      return Astro.redirect(safeNext);
    }
  }
}

const sessionHint = getAdminEmail(Astro.cookies);
---
<BaseLayout title="Admin login | NotaioGiusto.it" noindex={true} canonicalPath="/admin/login">
  <section class="section auth-page">
    <div class="card funnel-card auth-card">
      <span class="eyebrow">Console admin</span>
      <h1>Accedi all’area admin</h1>
      <p class="lead">
        Stesso modello di veterinari.org: Google Login (account autorizzato) oppure email + password admin.
        Admin: <code>romolo.velati@gmail.com</code>
      </p>
      {error && <div class="error">{error}</div>}
      {sessionHint && <div class="notice">Sessione attiva: {sessionHint}</div>}

      {googleEnabled ? (
        <div class="funnel-actions" style="margin-bottom:1.25rem">
          <a class="btn secondary auth-google-btn" rel="nofollow" href={googleHref}>Continua con Google</a>
        </div>
      ) : (
        <div class="notice" style="margin-bottom:1rem">Google OAuth non configurato.</div>
      )}

      <p class="helper-text" style="margin-bottom:1rem;text-align:center">oppure email + password</p>

      <form method="post" action="/admin/login">
        <input type="hidden" name="next" value={next} />
        <label>
          Email admin
          <input required type="email" name="email" value="romolo.velati@gmail.com" autocomplete="username" />
        </label>
        <label>
          Password admin
          <input required type="password" name="password" autocomplete="current-password" />
        </label>
        <div class="funnel-actions">
          <button class="btn navy" type="submit">Entra</button>
          <a class="btn secondary" href="/">Torna al sito</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
