---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminAuthenticated } from '../../lib/admin';
import { titleCase } from '../../lib/format';
import { listQuoteRequests } from '../../lib/notai';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const requests = await listQuoteRequests(150);
---
<BaseLayout title="Richieste preventivo | Admin NotaioGiusto.it" noindex={true}>
  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">Admin</span>
      <h1>Richieste preventivo</h1>
      <p>Ultime {requests.length} richieste salvate in database. Invio email ai notai ancora da collegare.</p>
    </div>
    <div class="admin-toolbar">
      <a class="btn secondary" href="/admin/logout">Esci</a>
    </div>
    <div class="list">
      {requests.map((item) => (
        <article class="card admin-request">
          <div class="admin-request__head">
            <div>
              <h2>{item.service_name}</h2>
              <p>
                {item.comune ? titleCase(item.comune) : 'Località non indicata'}
                · {new Date(item.created_at).toLocaleString('it-IT')}
                · stato {item.status}
              </p>
            </div>
            <span class="pill green">{item.recipient_count} notai</span>
          </div>
          <div class="summary-grid">
            <div><span>Email</span><strong>{item.requester_email}</strong></div>
            <div><span>Nome</span><strong>{item.requester_name || '—'}</strong></div>
            <div><span>Telefono</span><strong>{item.requester_phone || '—'}</strong></div>
            <div><span>Destinatari</span><strong>{item.recipient_names || 'Nessun notaio selezionato'}</strong></div>
          </div>
          {item.requester_message && <p class="summary-message"><strong>Messaggio:</strong> {item.requester_message}</p>}
          {item.case_details && (
            <details>
              <summary>Dettagli pratica (JSON)</summary>
              <pre class="admin-json">{JSON.stringify(item.case_details, null, 2)}</pre>
            </details>
          )}
        </article>
      ))}
      {!requests.length && <div class="notice">Nessuna richiesta ancora presente.</div>}
    </div>
  </section>
</BaseLayout>
