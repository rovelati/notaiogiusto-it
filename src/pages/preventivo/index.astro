---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalDisclaimer from '../../components/LegalDisclaimer.astro';
import { createMathChallenge } from '../../lib/antispam';
import { getClientEmail } from '../../lib/client-auth';
import { euro, titleCase } from '../../lib/format';
import {
  getAllServices,
  getNotariesByIds,
  getService,
  MAX_QUOTE_NOTARIES,
  searchNotaries,
  searchNotariesForLocation,
} from '../../lib/notai';
import {
  cadastralSummary,
  getPropertiesByIdsForEmail,
  listShareableClientProperties,
} from '../../lib/properties';
import { getServiceIntake, intakeFromSearchParams } from '../../lib/service-intake';

const params = Astro.url.searchParams;
const step = Math.min(4, Math.max(1, Number(params.get('step') || '1') || 1));
const serviceSlug = (params.get('servizio') || '').trim();
const comune = (params.get('comune') || '').trim();
const name = (params.get('name') || '').trim();
const email = (params.get('email') || '').trim();
const phone = (params.get('phone') || '').trim();
const message = (params.get('message') || '').trim();
const urgency = (params.get('urgency') || '').trim();
const propertyValue = (params.get('property_value') || '').trim();
const parties = (params.get('parties') || '').trim();
const documentsReady = (params.get('documents_ready') || '').trim();
const selectedIds = [...new Set([
  ...params.getAll('notary_ids').map((value) => value.trim()),
  ...(params.get('notary') || '').split(',').map((value) => value.trim()),
].filter(Boolean))].slice(0, MAX_QUOTE_NOTARIES);
const selectedPropertyIds = [...new Set(params.getAll('property_ids').map((value) => value.trim()).filter(Boolean))].slice(0, 10);
const clientEmail = getClientEmail(Astro.cookies);
const fascicoloEmail = (email || clientEmail || '').trim().toLowerCase();

const service = serviceSlug ? await getService(serviceSlug) : null;
if (service?.requested_slug && service.requested_slug !== service.slug) {
  const canonicalParams = new URLSearchParams(params);
  canonicalParams.set('servizio', service.slug);
  return Astro.redirect(`/preventivo?${canonicalParams}`, 301);
}
if (service?.requested_is_searchable === false) {
  const canonicalParams = new URLSearchParams(params);
  canonicalParams.delete('servizio');
  canonicalParams.set('step', '1');
  return Astro.redirect(`/preventivo?${canonicalParams}`, 301);
}
const [services, selectedNotaries, locationCandidates, declaredCandidates, shareableProperties, selectedProperties] = await Promise.all([
  getAllServices(),
  getNotariesByIds(selectedIds),
  step >= 3 && comune
    ? searchNotariesForLocation({ comune, limit: 24, minLocal: 1 }).then((pack) => pack.notaries)
    : Promise.resolve([]),
  step >= 3 && comune && service
    ? searchNotaries({
        comune,
        serviceId: service.id,
        serviceSlug: service.slug,
        limit: 48,
      })
    : Promise.resolve([]),
  fascicoloEmail ? listShareableClientProperties(fascicoloEmail) : Promise.resolve([]),
  fascicoloEmail && selectedPropertyIds.length
    ? getPropertiesByIdsForEmail(selectedPropertyIds, fascicoloEmail)
    : Promise.resolve([]),
]);

const candidates = locationCandidates.length ? locationCandidates : declaredCandidates;
const serviceName = service?.plain_language_name || service?.name || '';
const intake = service ? getServiceIntake(service) : null;
const intakeValues = intake ? intakeFromSearchParams(params, intake.fields) : {};
const locationLabel = comune ? titleCase(comune) : '';
const antispam = step === 4 ? createMathChallenge() : null;
const steps = [
  { n: 1, label: 'Servizio' },
  { n: 2, label: 'Pratica' },
  { n: 3, label: 'Notai' },
  { n: 4, label: 'Riepilogo' },
];
const servicesByCategory = services.reduce<Record<string, typeof services>>((acc, item) => {
  const key = item.category || 'Altri servizi';
  (acc[key] ||= []).push(item);
  return acc;
}, {});

const candidateMap = new Map<string, (typeof candidates)[number] & {
  declared_service?: boolean;
  declared_match?: string | null;
  service_match_source?: string | null;
  distance_km?: number | null;
}>();
for (const notary of candidates) {
  candidateMap.set(notary.id, notary);
}
for (const notary of declaredCandidates) {
  const existing = candidateMap.get(notary.id);
  if (!existing && locationCandidates.length) continue;
  candidateMap.set(
    notary.id,
    existing
      ? {
          ...existing,
          declared_service: Boolean(existing.declared_service || notary.declared_service),
          declared_match: existing.declared_match || notary.declared_match || null,
          service_match_source: existing.service_match_source || notary.service_match_source || null,
        }
      : notary,
  );
}
for (const notary of selectedNotaries) {
  const existing = candidateMap.get(notary.id);
  candidateMap.set(
    notary.id,
    existing
      ? {
          ...existing,
          ...notary,
          declared_service: Boolean(existing.declared_service || notary.declared_service),
          declared_match: existing.declared_match || notary.declared_match || null,
          service_match_source: existing.service_match_source || notary.service_match_source || null,
        }
      : notary,
  );
}
const notaryChoices = [...candidateMap.values()].sort((a, b) => {
  const selectedRank = (id: string) => (selectedIds.includes(id) ? 0 : 1);
  const declaredRank = (item: (typeof a)) =>
    item.declared_match === 'exact' ? 0 : item.declared_match === 'related' || item.declared_service ? 1 : 2;
  const cityRank = (item: (typeof a)) =>
    locationLabel && (item.comune || '').toLowerCase() === locationLabel.toLowerCase() ? 0 : 1;
  const distA = typeof a.distance_km === 'number' ? a.distance_km : 9999;
  const distB = typeof b.distance_km === 'number' ? b.distance_km : 9999;
  return (
    selectedRank(a.id) - selectedRank(b.id) ||
    declaredRank(a) - declaredRank(b) ||
    cityRank(a) - cityRank(b) ||
    distA - distB ||
    a.full_name.localeCompare(b.full_name, 'it')
  );
});

const autoSelectIds =
  step === 3 &&
  selectedIds.length === 0 &&
  notaryChoices.length > 0 &&
  notaryChoices.length <= MAX_QUOTE_NOTARIES
    ? notaryChoices.map((notary) => notary.id)
    : selectedIds;
const checkedIds = new Set(autoSelectIds);
function hiddenFields(includeNotaries = true, includeProperties = true) {
  const pairs: Array<[string, string]> = [];
  const scalars: Array<[string, string]> = [
    ['servizio', serviceSlug],
    ['comune', comune],
    ['name', name],
    ['email', email],
    ['phone', phone],
    ['message', message],
    ['urgency', urgency],
    ['property_value', propertyValue],
    ['parties', parties],
    ['documents_ready', documentsReady],
  ];
  for (const [key, value] of scalars) {
    if (value) pairs.push([key, value]);
  }
  for (const [key, value] of Object.entries(intakeValues)) {
    if (value) pairs.push([`intake_${key}`, value]);
  }
  if (includeNotaries) {
    for (const id of selectedIds) pairs.push(['notary_ids', id]);
  }
  if (includeProperties) {
    for (const id of selectedPropertyIds) pairs.push(['property_ids', id]);
  }
  return pairs;
}

function stepHref(targetStep: number, includeNotaries = true) {
  const qs = new URLSearchParams();
  qs.set('step', String(targetStep));
  for (const [key, value] of hiddenFields(includeNotaries)) qs.append(key, value);
  return `/preventivo?${qs.toString()}`;
}

const canGoStep2 = Boolean(service);
const canGoStep3 = Boolean(service && comune && email.includes('@'));
const canGoStep4 = Boolean(
  canGoStep3 && selectedNotaries.length > 0 && selectedNotaries.length <= MAX_QUOTE_NOTARIES,
);

const primaryNotary = selectedNotaries[0] || null;
const primaryNotaryName = primaryNotary ? titleCase(primaryNotary.full_name) : '';
const slotsLeft = Math.max(0, MAX_QUOTE_NOTARIES - selectedNotaries.length);
const hasMissionContext = Boolean(service && (primaryNotary || locationLabel));
const heroTitle = service
  ? primaryNotary
    ? `Preventivo per ${serviceName}`
    : `Preventivo per ${serviceName}${locationLabel ? ` a ${locationLabel}` : ''}`
  : 'Richiedi un preventivo notarile chiaro';
const heroLead = primaryNotary
  ? `Lo stai chiedendo a ${primaryNotaryName}${locationLabel ? ` · ${locationLabel}` : ''}. Puoi estendere la stessa richiesta fino a ${slotsLeft || 0} ${slotsLeft === 1 ? 'altro notaio' : 'altri notai'} della zona.`
  : service
    ? `Descrivi la pratica${locationLabel ? ` a ${locationLabel}` : ''} e scegli fino a ${MAX_QUOTE_NOTARIES} notai a cui inviare la richiesta.`
    : `Quattro passaggi: servizio, dati pratica, scelta fino a ${MAX_QUOTE_NOTARIES} notai e riepilogo prima dell’invio.`;
---
<BaseLayout
  title={service
    ? `Preventivo ${serviceName}${primaryNotaryName ? ` · ${primaryNotaryName}` : ''}${locationLabel ? ` · ${locationLabel}` : ''} | NotaioGiusto.it`
    : 'Richiedi preventivo notarile | NotaioGiusto.it'}
  description={`Scegli il servizio, descrivi la pratica, seleziona fino a ${MAX_QUOTE_NOTARIES} notai e invia una richiesta di preventivo chiara.`}
  noindex={true}
  canonicalPath="/preventivo"
>
  <div
    hidden
    data-analytics-funnel
    data-step={String(step)}
    data-step-name={steps.find((item) => item.n === step)?.label || `step_${step}`}
    data-service={serviceSlug || ''}
    data-comune={comune || ''}
    data-notary-count={String(selectedNotaries.length)}
  ></div>
  <section class="funnel-hero">
    <span class="eyebrow">{hasMissionContext ? 'Preventivo in corso' : 'Preventivo guidato'}</span>
    <h1>{heroTitle}</h1>
    <p class="lead">{heroLead}</p>
    <LegalDisclaimer variant="inline" />
    <ol class="funnel-steps">
      {steps.map((item) => (
        <li class={item.n === step ? 'is-active' : item.n < step ? 'is-done' : ''}>
          <span>{item.n}</span>
          {item.label}
        </li>
      ))}
    </ol>
  </section>

  {hasMissionContext && (
    <section class="funnel-mission" aria-label="Cosa stai richiedendo">
      <div class="funnel-mission__inner">
        <div class="funnel-mission__main">
          <p class="funnel-mission__label">Stai chiedendo</p>
          <h2>
            Preventivo per <strong>{serviceName}</strong>
            {locationLabel ? <> · {locationLabel}</> : null}
          </h2>
          {primaryNotary ? (
            <p class="funnel-mission__meta">
              Studio principale: <strong>{primaryNotaryName}</strong>
              {primaryNotary.comune ? ` · ${titleCase(primaryNotary.comune)}` : ''}
              {primaryNotary.address ? ` · ${primaryNotary.address}` : ''}
            </p>
          ) : locationLabel ? (
            <p class="funnel-mission__meta">
              Dopo i dettagli potrai scegliere fino a {MAX_QUOTE_NOTARIES} notai a {locationLabel}.
            </p>
          ) : null}
        </div>

        {selectedNotaries.length > 0 && (
          <div class="funnel-mission__picks">
            <div class="funnel-mission__picks-head">
              <span>
                <strong>{selectedNotaries.length}</strong>/{MAX_QUOTE_NOTARIES} studi in richiesta
              </span>
              {slotsLeft > 0 && step < 3 ? (
                <em>Puoi aggiungerne fino a {slotsLeft}</em>
              ) : slotsLeft > 0 && step >= 3 ? (
                <em>Aggiungi altri qui sotto</em>
              ) : (
                <em>Massimo raggiunto</em>
              )}
            </div>
            <ul class="funnel-mission__chips">
              {selectedNotaries.map((notary, index) => (
                <li>
                  <span class="funnel-mission__chip-rank">{index + 1}</span>
                  <strong>{titleCase(notary.full_name)}</strong>
                  <span>{notary.comune ? titleCase(notary.comune) : 'Studio'}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="funnel-mission__footer">
          {step === 2 && primaryNotary && slotsLeft > 0 && (
            <p class="funnel-mission__hint">
              Al passo “Notai” potrai estendere la stessa richiesta ad altri studi della zona.
            </p>
          )}
          {step >= 3 && slotsLeft > 0 && (
            <p class="funnel-mission__hint">
              Spunta altri studi sotto (max {MAX_QUOTE_NOTARIES}) per confrontare i preventivi.
            </p>
          )}
          {service && (
            <a class="btn secondary funnel-mission__guide" href={`/quanto-costa/${service.slug}`}>
              Guida alla pratica
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section funnel-section">
    {step === 1 && (
      <div class="funnel-stack">
        <form class="card funnel-card" method="get" action="/preventivo">
          <input type="hidden" name="step" value="2" />
          <h2>1. Quale prestazione ti serve?</h2>
          <p>Scegli la pratica: nel passo successivo ti chiediamo i dettagli utili a un preventivo confrontabile, tipizzati per atto notarile.</p>
          <label>
            <span class="form-label-row">
              <span>Servizio notarile</span>
              <span class="field-status field-status--required">Obbligatorio</span>
            </span>
            <select name="servizio" required>
              <option value="">Scegli un servizio</option>
              {services.map((item) => (
                <option value={item.slug} selected={item.slug === serviceSlug}>
                  {item.plain_language_name || item.name}
                </option>
              ))}
            </select>
          </label>
          {params.get('notary') && <input type="hidden" name="notary" value={params.get('notary') || ''} />}
          <div class="funnel-actions">
            <button class="btn blue" type="submit">Continua con i dettagli pratica</button>
          </div>
        </form>
        <div class="card funnel-card">
          <h3>Prestazioni più chiare da descrivere</h3>
          <div class="service-pick-groups">
            {Object.entries(servicesByCategory).slice(0, 6).map(([category, items]) => (
              <div>
                <strong>{category}</strong>
                <div class="service-pick-grid">
                  {items.slice(0, 4).map((item) => (
                    <a class="service-pick" rel="nofollow" href={`/preventivo?step=2&servizio=${encodeURIComponent(item.slug)}${params.get('notary') ? `&notary=${encodeURIComponent(params.get('notary') || '')}` : ''}`}>
                      <span>{item.plain_language_name || item.name}</span>
                      <em>{item.user_intent || 'Preventivo guidato con dettagli pratica'}</em>
                      <small>{euro(item.price_avg_cents)} · complessità {item.complexity || 'media'}</small>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {step === 2 && (
      <form class="card funnel-card" method="get" action="/preventivo">
        <input type="hidden" name="step" value="3" />
        <input type="hidden" name="servizio" value={serviceSlug} />
        {selectedIds.map((id) => <input type="hidden" name="notary_ids" value={id} />)}
        <div class="funnel-form-heading">
          <div>
            <p class="funnel-form-heading__eyebrow">Passaggio rapido</p>
            <h2>2. Inserisci i dati della pratica</h2>
          </div>
          <span class="funnel-form-heading__time">Circa 2 minuti</span>
        </div>
        <div class="funnel-required-note">
          <strong>Per continuare bastano 2 dati:</strong>
          <span>comune ed email.</span>
          Tutti gli altri campi sono facoltativi, ma aiutano gli studi a formulare un preventivo più preciso.
        </div>
        {!canGoStep2 && <div class="error">Seleziona prima un servizio valido.</div>}
        {service && intake && (
          <div class="service-brief">
            <div class="funnel-context">
              <span class="funnel-context__service"><strong>{serviceName}</strong></span>
              <span>{euro(service.price_avg_cents)} media indicativa</span>
              <span>{intake.profileLabel}</span>
            </div>
            <p class="service-brief__lead">{intake.intro}</p>
            <details class="doc-hints">
              <summary>Documenti utili — non devi caricarli ora</summary>
              <ul class="check-list">
                {intake.documentHints.map((doc) => <li>{doc}</li>)}
              </ul>
            </details>
            <p class="helper-text">
              Guida completa:
              <a href={`/quanto-costa/${service.slug}`}>quanto costa {serviceName.toLowerCase()}</a>
            </p>
          </div>
        )}
        <section class="funnel-field-section funnel-field-section--required">
          <div class="funnel-field-section__head">
            <div>
              <h3>Dati indispensabili</h3>
              <p>Servono per trovare gli studi corretti e inviarti la conferma.</p>
            </div>
            <span>2 campi</span>
          </div>
          <div class="funnel-grid">
            <label>
              <span class="form-label-row">
                <span>Comune della pratica</span>
                <span class="field-status field-status--required">Obbligatorio</span>
              </span>
              <input required name="comune" value={comune} placeholder="Es. Milano" autocomplete="address-level2" />
              <small class="field-help">Mostreremo i notai disponibili nella zona.</small>
            </label>
            <label>
              <span class="form-label-row">
                <span>Email</span>
                <span class="field-status field-status--required">Obbligatorio</span>
              </span>
              <input required type="email" name="email" value={email} placeholder="nome@email.it" autocomplete="email" />
              <small class="field-help">Riceverai qui conferma e risposte degli studi.</small>
            </label>
          </div>
        </section>

        <section class="funnel-field-section">
          <div class="funnel-field-section__head">
            <div>
              <h3>Come preferisci essere ricontattato?</h3>
              <p>Facoltativo: puoi proseguire anche senza nome e telefono.</p>
            </div>
            <span class="field-status">Facoltativo</span>
          </div>
          <div class="funnel-grid">
            <label>
              <span class="form-label-row"><span>Nome</span><span class="field-status">Facoltativo</span></span>
              <input name="name" value={name} placeholder="Il tuo nome" autocomplete="name" />
            </label>
            <label>
              <span class="form-label-row"><span>Telefono</span><span class="field-status">Facoltativo</span></span>
              <input name="phone" value={phone} placeholder="Es. 333 1234567" autocomplete="tel" inputmode="tel" />
            </label>
          </div>
        </section>

        <section class="funnel-field-section">
          <div class="funnel-field-section__head">
            <div>
              <h3>Dettagli che migliorano il preventivo</h3>
              <p>Più elementi inserisci, più la risposta dello studio potrà essere concreta.</p>
            </div>
            <span class="field-status">Facoltativo</span>
          </div>
          <div class="funnel-grid">
            <label>
              <span class="form-label-row"><span>Parti coinvolte</span><span class="field-status">Facoltativo</span></span>
              <input name="parties" value={parties} placeholder="Es. 2 parti, debitore e creditore" />
            </label>
          <label>
            <span class="form-label-row"><span>Documenti già disponibili</span><span class="field-status">Facoltativo</span></span>
            <select name="documents_ready">
              <option value="">Non indicato</option>
              <option value="pochi" selected={documentsReady === 'pochi'}>Pochi / da preparare</option>
              <option value="parziali" selected={documentsReady === 'parziali'}>Parziali</option>
              <option value="quasi_tutti" selected={documentsReady === 'quasi_tutti'}>Quasi tutti</option>
            </select>
          </label>
          </div>

          {intake && (
            <>
              <h3 class="funnel-field-subtitle">{intake.title}</h3>
            <div class="funnel-grid">
              {intake.fields.map((field) => (
                <label class={field.type === 'textarea' ? 'full-span' : ''}>
                  <span class="form-label-row">
                    <span>{field.label}</span>
                    <span class={`field-status ${field.required ? 'field-status--required' : ''}`}>
                      {field.required ? 'Obbligatorio' : 'Facoltativo'}
                    </span>
                  </span>
                  {field.type === 'select' ? (
                    <select name={`intake_${field.name}`} required={field.required}>
                      {(field.options || []).map((option) => (
                        <option value={option.value} selected={(intakeValues[field.name] || '') === option.value}>
                          {option.label}
                        </option>
                      ))}
                    </select>
                  ) : field.type === 'textarea' ? (
                    <textarea name={`intake_${field.name}`} placeholder={field.placeholder || ''}>{intakeValues[field.name] || ''}</textarea>
                  ) : (
                    <input
                      name={`intake_${field.name}`}
                      type={field.type === 'number' ? 'number' : 'text'}
                      value={intakeValues[field.name] || ''}
                      placeholder={field.placeholder || ''}
                      required={field.required}
                    />
                  )}
                  {field.help && <small class="helper-text">{field.help}</small>}
                </label>
              ))}
            </div>
            </>
          )}

          <label>
            <span class="form-label-row"><span>Note libere / dettagli aggiuntivi</span><span class="field-status">Facoltativo</span></span>
            <textarea name="message" placeholder="Aggiungi solo ciò che può aiutare lo studio a capire meglio la richiesta...">{message}</textarea>
          </label>
        </section>
        <input type="hidden" name="urgency" value={urgency || intakeValues.timing_preference || ''} />
        <input type="hidden" name="property_value" value={propertyValue || intakeValues.deal_value || intakeValues.loan_amount || ''} />

        <div class="property-attach">
          <div class="funnel-field-section__head">
            <div>
              <h3>Immobili del fascicolo da condividere</h3>
              <p>Allega un immobile solo se è pertinente alla pratica.</p>
            </div>
            <span class="field-status">Facoltativo</span>
          </div>
          {shareableProperties.length ? (
            <>
              <p class="helper-text">Seleziona gli immobili i cui dati catastali vuoi allegare a questa pratica (es. 730, compravendita, successione).</p>
              <div class="list">
                {shareableProperties.map((property) => (
                  <label class={`notary-pick ${selectedPropertyIds.includes(property.id) ? 'is-selected' : ''}`}>
                    <input
                      type="checkbox"
                      name="property_ids"
                      value={property.id}
                      checked={selectedPropertyIds.includes(property.id)}
                    />
                    <span>
                      <strong>{property.nickname}</strong>
                      <em>{cadastralSummary(property)}{property.comune ? ` · ${titleCase(property.comune)}` : ''}</em>
                    </span>
                  </label>
                ))}
              </div>
            </>
          ) : (
            <p class="helper-text">
              Nessun immobile condivisibile nel fascicolo.
              <a href="/area-clienti/immobili/nuovo">Aggiungine uno</a> (serve accesso area clienti con la stessa email).
            </p>
          )}
        </div>

        <div class="funnel-actions">
          <a class="btn secondary" rel="nofollow" href={`/preventivo?step=1&servizio=${encodeURIComponent(serviceSlug)}${selectedIds.length ? `&notary=${encodeURIComponent(selectedIds.join(','))}` : ''}`}>Indietro</a>
          <button class="btn blue" type="submit" disabled={!canGoStep2}>
            {primaryNotary
              ? slotsLeft > 0
                ? 'Continua · puoi aggiungere altri notai'
                : 'Continua'
              : 'Scegli i notai'}
          </button>
        </div>
        <p class="funnel-action-reassurance">
          Nessun pagamento e nessun invio in questa fase. Potrai controllare tutto prima di confermare.
        </p>
      </form>
    )}

    {step === 3 && (
      <div class="funnel-stack">
        {!canGoStep3 && <div class="error">Completa servizio, comune ed email prima di scegliere i notai.</div>}
        <form class="card funnel-card" method="get" action="/preventivo">
          <input type="hidden" name="step" value="3" />
          {hiddenFields(false).map(([key, value]) => (
            key === 'comune' ? null : <input type="hidden" name={key} value={value} />
          ))}
          {selectedIds.map((id) => <input type="hidden" name="notary_ids" value={id} />)}
          <h2>3. Seleziona fino a {MAX_QUOTE_NOTARIES} notai</h2>
          <div class="funnel-required-note funnel-required-note--compact">
            <strong>Seleziona almeno 1 studio.</strong>
            Puoi sceglierne fino a {MAX_QUOTE_NOTARIES} per confrontare più risposte con una sola richiesta.
          </div>
          <p>
            {primaryNotary
              ? <>
                  <strong>{primaryNotaryName}</strong> è già selezionato per <strong>{serviceName}</strong>.
                  {slotsLeft > 0
                    ? ` Spunta fino a ${slotsLeft} ${slotsLeft === 1 ? 'altro studio' : 'altri studi'} per estendere la stessa richiesta e confrontare i preventivi.`
                    : ` Hai già ${MAX_QUOTE_NOTARIES} studi: deselezionane uno per sostituirlo.`}
                </>
              : <>
                  Scegli fino a {MAX_QUOTE_NOTARIES} notai a cui inviare la richiesta di <strong>{serviceName || 'preventivo'}</strong>.
                  In cima trovi gli studi con servizio dichiarato o affine; gli altri sono nella zona (anche per prossimità).
                </>}
          </p>
          <div class="funnel-grid">
            <label>Comune <input name="comune" value={comune} placeholder="Es. Milano" /></label>
            <div class="funnel-actions inline">
              <button class="btn secondary" type="submit">Aggiorna elenco</button>
            </div>
          </div>
        </form>

        <form class="card funnel-card" method="get" action="/preventivo">
          <input type="hidden" name="step" value="4" />
          {hiddenFields(false).map(([key, value]) => <input type="hidden" name={key} value={value} />)}
          <div class="notary-pick-toolbar">
            <p class="helper-text" id="notary-limit-hint" style="margin:0">
              Selezionati {autoSelectIds.length}/{MAX_QUOTE_NOTARIES} studi notarili.
            </p>
            <div class="notary-pick-toolbar__actions">
              <button class="btn secondary" type="button" data-notary-select-all>Seleziona tutti</button>
              <button class="btn secondary" type="button" data-notary-clear>Deseleziona</button>
            </div>
          </div>
          <div class="notary-pick-list list">
            {notaryChoices.map((notary) => {
              const checked = checkedIds.has(notary.id);
              const exactCity = locationLabel && (notary.comune || '').toLowerCase() === locationLabel.toLowerCase();
              const distanceKm =
                typeof (notary as { distance_km?: number | null }).distance_km === 'number'
                  ? (notary as { distance_km?: number | null }).distance_km
                  : null;
              return (
                <label class={`notary-pick notary-pick--compact ${checked ? 'is-selected' : ''}`}>
                  <input type="checkbox" name="notary_ids" value={notary.id} checked={checked} />
                  <span>
                    <strong>{titleCase(notary.full_name)}</strong>
                    <em>
                      {notary.address || 'Indirizzo non disponibile'}
                      {notary.comune ? ` · ${titleCase(notary.comune)}` : ''}
                      {distanceKm != null ? ` · ~${distanceKm.toFixed(1).replace('.', ',')} km` : ''}
                    </em>
                    <span class="result-badges">
                      {checked && <span>Selezionato</span>}
                      {notary.declared_match === 'exact'
                        ? <span>Servizio dichiarato</span>
                        : notary.declared_match === 'related' || notary.declared_service
                          ? <span>Servizio affine</span>
                          : null}
                      {notary.is_official_notariato && (
                        <span class="official-mark" title="Fonte ufficiale Consiglio Nazionale del Notariato">Ufficiale</span>
                      )}
                    </span>
                  </span>
                </label>
              );
            })}
          </div>
          {!notaryChoices.length && <div class="notice">Nessun notaio trovato per questa località. Prova un comune vicino o più ampio.</div>}
          <div class="funnel-actions">
            <a class="btn secondary" rel="nofollow" href={stepHref(2)}>Indietro</a>
            <button class="btn blue" type="submit" disabled={!notaryChoices.length}>Vai al riepilogo</button>
          </div>
        </form>
      </div>
    )}

    {step === 4 && (
      <div class="funnel-stack">
        {!canGoStep4 && <div class="error">Seleziona da 1 a {MAX_QUOTE_NOTARIES} notai per continuare.</div>}
        <div class="card funnel-card">
          <h2>4. Riepilogo richiesta</h2>
          <div class="summary-grid">
            <div><span>Servizio</span><strong>{serviceName || '—'}</strong></div>
            <div><span>Località</span><strong>{locationLabel || '—'}</strong></div>
            <div><span>Email</span><strong>{email || '—'}</strong></div>
            <div><span>Telefono</span><strong>{phone || '—'}</strong></div>
            <div><span>Urgenza</span><strong>{urgency || 'Non indicata'}</strong></div>
            <div><span>Valore indicativo</span><strong>{propertyValue || '—'}</strong></div>
            <div><span>Parti</span><strong>{parties || '—'}</strong></div>
            <div><span>Documenti</span><strong>{documentsReady || '—'}</strong></div>
          </div>
          {message && <p class="summary-message"><strong>Note:</strong> {message}</p>}
          {intake && Object.keys(intakeValues).length > 0 && (
            <>
              <h3>Dettagli pratica · {intake.profileLabel}</h3>
              <div class="summary-grid">
                {intake.fields.filter((field) => intakeValues[field.name]).map((field) => (
                  <div>
                    <span>{field.label}</span>
                    <strong>{intakeValues[field.name]}</strong>
                  </div>
                ))}
              </div>
            </>
          )}
          <h3>Immobili allegati ({selectedProperties.length})</h3>
          {selectedProperties.length ? (
            <ul class="summary-notaries">
              {selectedProperties.map((property) => (
                <li>
                  <strong>{property.nickname}</strong>
                  <span>{cadastralSummary(property)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="helper-text">Nessun immobile allegato dal fascicolo.</p>
          )}
          <h3>Notai selezionati ({selectedNotaries.length}/{MAX_QUOTE_NOTARIES})</h3>
          <ul class="summary-notaries">
            {selectedNotaries.map((notary) => (
              <li>
                <strong>{titleCase(notary.full_name)}</strong>
                <span>{notary.comune ? titleCase(notary.comune) : 'Comune non disponibile'}</span>
              </li>
            ))}
          </ul>
        </div>

        {canGoStep4 && (
          <form class="card funnel-card" method="post" action="/api/quote-request">
            <input type="hidden" name="service_slug" value={serviceSlug} />
            <input type="hidden" name="service_name" value={serviceName} />
            <input type="hidden" name="comune" value={comune} />
            <input type="hidden" name="email" value={email} />
            <input type="hidden" name="name" value={name} />
            <input type="hidden" name="phone" value={phone} />
            <input type="hidden" name="message" value={message} />
            <input type="hidden" name="urgency" value={urgency || intakeValues.timing_preference || ''} />
            <input type="hidden" name="property_value" value={propertyValue || intakeValues.deal_value || intakeValues.loan_amount || ''} />
            <input type="hidden" name="parties" value={parties} />
            <input type="hidden" name="documents_ready" value={documentsReady} />
            {Object.entries(intakeValues).map(([key, value]) => (
              <input type="hidden" name={`intake_${key}`} value={value} />
            ))}
            {selectedNotaries.map((notary) => <input type="hidden" name="notary_ids" value={notary.id} />)}
            {selectedProperties.map((property) => <input type="hidden" name="property_ids" value={property.id} />)}
            <input type="hidden" name="antispam_token" value={antispam?.token || ''} />
            <label class="antispam-honeypot" aria-hidden="true">
              Sito web
              <input type="text" name="website" value="" tabindex="-1" autocomplete="off" />
            </label>
            <p>Conferma per salvare la richiesta nel database. L’invio email ai notai arriverà nel passo successivo.</p>
            <div class="funnel-grid">
              <label>
                <span class="form-label-row">
                  <span>Codice antispam: quanto fa {antispam?.question}?</span>
                  <span class="field-status field-status--required">Obbligatorio</span>
                </span>
                <input
                  name="antispam_answer"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete="off"
                  required
                  placeholder="Risultato"
                />
              </label>
            </div>
            <div class="funnel-actions">
              <a class="btn secondary" rel="nofollow" href={stepHref(3)}>Indietro</a>
              <button
                class="btn blue"
                type="submit"
                data-analytics-event="quote_request_attempt"
                data-analytics-params={JSON.stringify({ service_slug: serviceSlug, comune: comune || null })}
              >
                Invia richiesta
              </button>
            </div>
            <LegalDisclaimer variant="compact" />
          </form>
        )}
      </div>
    )}
  </section>
</BaseLayout>

<script define:vars={{ maxNotaries: MAX_QUOTE_NOTARIES }}>
  const boxes = Array.from(document.querySelectorAll('input[type="checkbox"][name="notary_ids"]'));
  const hint = document.getElementById('notary-limit-hint');
  const selectAllBtn = document.querySelector('[data-notary-select-all]');
  const clearBtn = document.querySelector('[data-notary-clear]');

  function syncLimit() {
    const checked = boxes.filter((box) => box.checked);
    boxes.forEach((box) => {
      const row = box.closest('.notary-pick');
      if (row) row.classList.toggle('is-selected', box.checked);
      box.disabled = !box.checked && checked.length >= maxNotaries;
    });
    if (hint) hint.textContent = `Selezionati ${checked.length}/${maxNotaries} studi notarili.`;
  }

  boxes.forEach((box) => box.addEventListener('change', syncLimit));
  selectAllBtn?.addEventListener('click', () => {
    boxes.slice(0, maxNotaries).forEach((box) => {
      box.checked = true;
    });
    boxes.slice(maxNotaries).forEach((box) => {
      box.checked = false;
    });
    syncLimit();
  });
  clearBtn?.addEventListener('click', () => {
    boxes.forEach((box) => {
      box.checked = false;
    });
    syncLimit();
  });
  syncLimit();
</script>
