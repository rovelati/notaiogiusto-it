---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Area notai | Ricevi richieste qualificate">
  <section class="hero">
    <div>
      <span class="eyebrow">Lato studio notarile</span>
      <h1>Ricevi richieste complete, non lead generici.</h1>
      <p class="lead">Rivendichi il profilo, aggiorni ambiti, zone e disponibilità, e ricevi pratiche con informazioni già strutturate.</p>
      <div class="actions">
        <a class="btn" href="/claim">Rivendica il profilo</a>
        <a class="btn secondary" href="/notai">Trova la tua scheda</a>
      </div>
    </div>
    <div class="card">
      <h2>CRM leggero MVP</h2>
      <p>Inbox richieste, score completezza, documenti presenti/mancanti, preventivi strutturati e statistiche su visite, click e richieste.</p>
      <div class="meta">
        <span class="pill green">Claim gratuito</span>
        <span class="pill">Analytics base</span>
        <span class="pill gold">Max richieste qualificate</span>
      </div>
    </div>
  </section>
</BaseLayout>
