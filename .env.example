SITE_URL=https://www.notaiogiusto.it
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME
ADMIN_TOKEN=cambia-questo-token-admin
# Email admin (csv). Default: romolo.velati@gmail.com
ADMIN_EMAILS=romolo.velati@gmail.com
AUTH_SECRET=cambia-questo-secret-sessioni-clienti
# Auth: email+password e/o Google (niente magic link / verifica email)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.notaiogiusto.it/api/auth/google/callback
# Opzionale: email transazionali (preventivi, ecc.) — non usata per login
MAIL_FROM="NotaioGiusto Preventivi <preventivi@notaiogiusto.it>"
MAIL_ADMIN_TO=preventivi@notaiogiusto.it
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Google Analytics 4 (stream NotaioGiusto)
PUBLIC_GA_MEASUREMENT_ID=G-NDREZNGP80
